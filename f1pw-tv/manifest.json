{
  "manifest_version": 3,
  "name": "Pit Wall – Diretta TV e dati sport",
  "version": "1.1.0",
  "description": "Per F1 Pit Wall e Sport LIVE APP: mostra i servizi di streaming nel riquadro Diretta TV e permette all'app di leggere i dati pubblici di MotoGP e WorldSBK.",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://*.nowtv.it/*",
    "https://*.sky.it/*",
    "https://*.formula1.com/*",
    "https://*.dazn.com/*",
    "https://*.tv8.it/*",
    "https://*.primevideo.com/*",
    "https://*.amazon.it/*",
    "https://*.mediaset.it/*",
    "https://*.raiplay.it/*",
    "https://*.rai.it/*",
    "https://*.nba.com/*",
    "https://*.supertennis.tv/*",
    "https://*.hbomax.com/*",
    "https://api.motogp.pulselive.com/*",
    "https://api.pulselive.worldsbk.com/*",
    "https://matteo-canna.github.io/*",
    "http://localhost/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "riquadro",
        "enabled": true,
        "path": "regole.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://matteo-canna.github.io/*",
        "http://localhost/*",
        "file:///*"
      ],
      "js": [
        "segnale.js"
      ],
      "run_at": "document_start"
    }
  ]
}
